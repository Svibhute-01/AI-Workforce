GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

CONTEXT_MODE=all_files

# RUNNER_MODE=docker          # run generated code in containers instead of on this machine
# SMOKE_CHECK=true
# APP_PUBLIC_HOST=127.0.0.1
# QA_AUTO_REPAIR_ROUNDS=2      # bounded QA -> Developer -> QA repair loop (0 disables it)
# INSTALL_TIMEOUT_SECONDS=600  # time limits for the slow steps; lower them to fail fast
# IMPORT_TIMEOUT_SECONDS=60
# TEST_TIMEOUT_SECONDS=300
# CACHE_DIR=./cache            # docker mode: shared pip/npm download cache for install containers
